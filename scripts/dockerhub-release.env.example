# Docker Hub 发布凭据模板
#
# 使用方法：
#   cp scripts/dockerhub-release.env.example config/dockerhub-release.env
#   然后编辑 config/dockerhub-release.env 填入真实值
#
# config/ 整个目录已被 .gitignore 忽略，真实凭据文件不会提交。

# Docker Hub 小写用户名（不是邮箱）
DOCKERHUB_USERNAME=

# Docker Hub Access Token：仅需目标仓库 Read & Write，不要用账号登录密码
DOCKERHUB_TOKEN=

# 可选：默认 <DOCKERHUB_USERNAME>/homepage；组织仓库填小写 namespace/repository
DOCKERHUB_IMAGE=

# 可选：必须是 fork-vX.Y.Z；留空则用 package.json 版本生成 fork-v<version>
RELEASE_VERSION=

# 可选：设为 1 跳过推送前运行时冒烟（不建议）
SKIP_SMOKE=
