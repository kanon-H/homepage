# Fork-only build. Never reuse a host .next tree or pass registry credentials as build arguments.
ARG NODE_IMAGE=node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53
FROM ${NODE_IMAGE} AS builder
WORKDIR /app
RUN apk add --no-cache bash && corepack enable && corepack prepare pnpm@10.34.9 --activate
COPY . .
ARG BUILDTIME
ARG VERSION
ARG REVISION
RUN test "$(node --version)" = 'v24.22.1' && test "$(pnpm --version)" = '10.34.9' && \
    mkdir -p config && pnpm install --frozen-lockfile && \
    NEXT_PUBLIC_BUILDTIME="$BUILDTIME" NEXT_PUBLIC_VERSION="$VERSION" NEXT_PUBLIC_REVISION="$REVISION" \
    bash scripts/fork-ci-build.sh

FROM ${NODE_IMAGE} AS runner
ARG BUILDTIME
ARG VERSION
ARG REVISION
ARG UPSTREAM_REVISION
LABEL org.opencontainers.image.title="Homepage Fork" \
      org.opencontainers.image.description="Personal Homepage fork; see the exact source revision for feature and acceptance status." \
      org.opencontainers.image.source="https://github.com/kanon-H/homepage" \
      org.opencontainers.image.url="https://github.com/kanon-H/homepage" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.created="$BUILDTIME" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.revision="$REVISION" \
      io.homepage.fork.upstream-revision="$UPSTREAM_REVISION"
WORKDIR /app
RUN apk add --no-cache su-exec iputils-ping shadow
COPY --chown=1000:1000 public ./public/
COPY --chmod=755 docker-entrypoint.sh /usr/local/bin/
COPY LICENSE /usr/share/doc/homepage/LICENSE
COPY --from=builder --chown=1000:1000 /app/.next/standalone/ ./
COPY --from=builder --chown=1000:1000 /app/.next/static/ ./.next/static/
USER root
ENV NODE_ENV=production HOSTNAME=:: PORT=3000
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s \
  CMD wget --no-verbose --tries=1 --spider -Y off http://127.0.0.1:$PORT/api/healthcheck || exit 1
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["node", "server.js"]
